# Copy to .env before the first `docker compose up`.
#   PowerShell:  Copy-Item .env.example .env

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO
TIME_ZONE=Asia/Tehran

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft
POSTGRES_DB=ft
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379

# --- Auth -----------------------------------------------------------------
# Refresh is deliberately long: a guest has no password, so an expired session
# means the account and everything in it is gone, not just a re-login.
JWT_ACCESS_HOURS=6
JWT_REFRESH_DAYS=180
THROTTLE_AUTH=20/hour
THROTTLE_PROFILE=60/hour
# Number of reverse proxies in front of Django. Leave unset in dev; set to 1
# in production behind Caddy, or rate limiting keys on the proxy's IP.
# NUM_PROXIES=1

# --- Product rules --------------------------------------------------------
MIN_AGE=18
MAX_GENDER_CHANGES=1

# --- Only needed if the frontend is ever served from a different origin.
# In dev, Vite proxies /api and /ws, so this stays empty.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Sentry (optional; leave blank to disable) ----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
