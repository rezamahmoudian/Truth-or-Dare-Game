# Copy to .env before the first `docker compose up`.
#   PowerShell:  Copy-Item .env.example .env

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# For LAN/mobile testing, append the computer's current IPv4 address above.
# WebSocket Origin validation uses this list too; HTTP proxying alone can work
# even when the LAN address is missing. Recreate backend after changing .env.
LOG_LEVEL=INFO
TIME_ZONE=Asia/Tehran

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=ft
POSTGRES_PASSWORD=ft
POSTGRES_DB=ft
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379

# --- Auth -----------------------------------------------------------------
# Refresh is deliberately long: a guest has no password, so an expired session
# means the account and everything in it is gone, not just a re-login.
JWT_ACCESS_HOURS=6
JWT_REFRESH_DAYS=180
THROTTLE_AUTH=20/hour
THROTTLE_PROFILE=60/hour
# Number of reverse proxies in front of Django. Leave unset in dev; set to 1
# in production behind Caddy, or rate limiting keys on the proxy's IP.
# NUM_PROXIES=1

# --- Product rules --------------------------------------------------------
MIN_AGE=18
MAX_GENDER_CHANGES=1

# --- Only needed if the frontend is ever served from a different origin.
# In dev, Vite proxies /api and /ws, so this stays empty.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Sentry (optional; leave blank to disable) ----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
AI_PLAYERS_ENABLED=False
OPENAI_API_KEY=
AI_PROVIDER=openai
# Switch only AI_PROVIDER: openai uses OPENAI_*; anthropic uses ANTHROPIC_*.
# Keep both configurations. Recreate backend, worker and beat after switching.
# For Anthropic-compatible gateways set AI_PROVIDER=anthropic and supply the exact model ID.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://claude.flearning.ir
ANTHROPIC_MODEL=
ANTHROPIC_API_VERSION=2023-06-01
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRA_HEADERS={}
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_LIMIT=1000
AI_USER_DAILY_REQUEST_LIMIT=100
AI_MAX_OUTPUT_TOKENS=500
AI_REQUEST_TIMEOUT=30
AI_HISTORY_MESSAGES=24
AI_MESSAGE_BATCH_SECONDS=1.5
AI_MAX_CONFIRMING_CHAT_MESSAGES=3
AI_CONFIRMING_CHAT_TIMEOUT_SECONDS=180

# Commerce foundation: keep ordering disabled until gateway integration.
BILLING_ORDERS_ENABLED=False
BILLING_ORDER_TTL_MINUTES=30
BILLING_PAYMENTS_ENABLED=False
BILLING_GATEWAY=
BILLING_GATEWAY_ADAPTERS={}
BILLING_PUBLIC_BASE_URL=
REWARDED_ADS_ENABLED=False
REWARDED_AD_PROVIDER=
REWARDED_ITEM_KEY=
REWARDED_AD_DAILY_LIMIT=1
MATCH_FUNDING_HOLD_SECONDS=900

# Storefront, VIP, collection and paid actions (runtime switch).
MONETIZATION_ENABLED=False
