# Production settings. Copy to .env.production on the server and fill in.
# Never commit the filled-in copy.

# --- the public address ------------------------------------------------------
# Caddy fetches and renews the TLS certificate for this name on its own. The
# DNS A record must already point at the server before the first start.
DOMAIN=jorat.example.ir

# --- Django --------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-STRING
DEBUG=False
ALLOWED_HOSTS=jorat.example.ir,backend
CSRF_TRUSTED_ORIGINS=https://jorat.example.ir
LOG_LEVEL=INFO
TIME_ZONE=Asia/Tehran

# One proxy (Caddy) sits in front of Django. Without this every request looks
# like it came from Caddy's IP and all users share a single rate limit.
NUM_PROXIES=1

UVICORN_WORKERS=2

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=ft
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=ft

# --- rate limits ---------------------------------------------------------------
THROTTLE_AUTH=20/hour
THROTTLE_PROFILE=60/hour
THROTTLE_MATCH=120/hour

# --- auth -------------------------------------------------------------------
JWT_ACCESS_HOURS=6
JWT_REFRESH_DAYS=180

# --- product rules ------------------------------------------------------------
MIN_AGE=18
MAX_GENDER_CHANGES=1
GAME_DEFAULT_ROUNDS=3
MATCH_TICKET_TTL_SECONDS=180

# --- Sentry (optional) -----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
