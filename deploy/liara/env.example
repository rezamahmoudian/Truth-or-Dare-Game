# Copy values into Liara's environment settings. Never commit real credentials.
DEBUG=False
DJANGO_SECRET_KEY=your-new-random-secret-at-least-32-characters
ALLOWED_HOSTS=truthordare.liara.run
CSRF_TRUSTED_ORIGINS=https://truthordare.liara.run
CORS_ALLOWED_ORIGINS=https://truthordare.liara.run
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE
REDIS_URL=redis://:PASSWORD@REDIS_HOST:6379/0
UVICORN_WORKERS=2
CELERY_CONCURRENCY=2
# Liara edge + internal nginx; verify the proxy count for a custom CDN.
NUM_PROXIES=2
BILLING_PUBLIC_BASE_URL=https://truthordare.liara.run

# Optional: keep blank until an API credential is configured.
AI_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://claude.flearning.ir
ANTHROPIC_MODEL=glm-5.3-flash
ANTHROPIC_AUTH_TOKEN=
# Switch AI_PROVIDER to openai to use the previous provider.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
